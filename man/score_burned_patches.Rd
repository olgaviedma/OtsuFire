\itemize{
  \item `class_final == "keep"`
  \item `filter_1 == "keep"`
  \item `filter_2 == "keep"`
  \item `filter_3 == "keep"`
  \item `conf_area == "ok"`
  \item `conf_pix == "ok"`
  \item minimum-area compliance
